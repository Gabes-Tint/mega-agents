#!/usr/bin/env bun
// A stand-in for Claude Code in browser tests: it answers print-mode turns
// with the stream-json envelope the real CLI prints, describing where it ran
// and what it was asked, so a flow can be checked without a model.
const args = process.argv.slice(2);
const prompt = args[args.indexOf("-p") + 1] ?? "";
const schemaIndex = args.indexOf("--json-schema");
// A prompt marked [slow] stands in for a long turn someone may cancel.
if (prompt.includes("[slow]")) await Bun.sleep(30_000);
// A prompt marked [wait] takes long enough to watch it run.
if (prompt.includes("[wait]")) await Bun.sleep(2_000);
const reply =
  schemaIndex >= 0
    ? JSON.stringify({ verdict: "approve" })
    : `worked in ${process.cwd()}: ${prompt}`;
const envelope = {
  type: "result",
  session_id: `fake-${process.pid}`,
  result: reply,
  ...(schemaIndex >= 0 ? { structured_output: { verdict: "approve" } } : {}),
};
console.log(
  JSON.stringify({
    type: "assistant",
    message: {
      content: [
        { type: "tool_use", name: "Bash", input: { command: "git status" } },
      ],
    },
  }),
);
console.log(JSON.stringify(envelope));
