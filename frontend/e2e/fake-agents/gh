#!/usr/bin/env bun
// A stand-in for the GitHub CLI in browser tests: issue #7 exists, and a
// pull request opens as #42.
const [command, subcommand] = process.argv.slice(2);
if (command === "issue" && subcommand === "view") {
  console.log(
    JSON.stringify({
      number: 7,
      title: "Add a changelog",
      body: "Write CHANGELOG.md",
      url: "https://github.com/acme/api/issues/7",
      labels: [],
      comments: [],
    }),
  );
} else if (command === "pr" && subcommand === "create") {
  console.log("https://github.com/acme/api/pull/42");
} else {
  console.error(`unexpected gh ${process.argv.slice(2).join(" ")}`);
  process.exit(1);
}
