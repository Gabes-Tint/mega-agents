#!/usr/bin/env bun
// A stand-in for the GitHub CLI in browser tests: issue #7 exists, issue #8
// is labeled "paused", the open issues are #8 and #9 (without labels), and a
// pull request opens as #42.
const [command, subcommand, number] = process.argv.slice(2);
if (command === "issue" && subcommand === "view") {
  const shown = number === "8" || number === "9" ? Number(number) : 7;
  console.log(
    JSON.stringify({
      number: shown,
      title: shown === 9 ? "Write the docs" : "Add a changelog",
      body: "Write CHANGELOG.md",
      url: `https://github.com/acme/api/issues/${shown}`,
      labels: shown === 8 ? [{ name: "paused" }] : [],
      comments: [],
    }),
  );
} else if (command === "issue" && subcommand === "list") {
  console.log(
    JSON.stringify([
      { number: 9, labels: [] },
      { number: 8, labels: [{ name: "paused" }] },
    ]),
  );
} else if (command === "pr" && subcommand === "create") {
  console.log("https://github.com/acme/api/pull/42");
} else {
  console.error(`unexpected gh ${process.argv.slice(2).join(" ")}`);
  process.exit(1);
}
